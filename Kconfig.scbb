# AiPi-SCBB core configuration: module enables + generic pin assignment.
#
# This file is sourceable (no mainmenu). It is consumed by:
#   - Kconfig            (standalone CMake builds, via menuconfig.py)
#   - the application's app_config/Kconfig (open SDK: the app sources this
#     fragment, so ./build.sh <chip> <app> menuconfig configures SCBB)
#
# It must NOT contain board/product names. In the open SDK an application
# (vendor/<chip>/app_config/.config) is the board definition. No open SDK
# build script is modified: the app's own Kconfig pulls this file in, and
# scbb_config.h reads the resulting CONFIG_* values from aiio_autoconf.h.

menu "AiPi-SCBB"

config SCBB_CH224A_ENABLED
    bool "Enable CH224A I2C USB-PD driver"
    default n
    help
        Enable CH224A I2C USB-PD driver.

if SCBB_CH224A_ENABLED
    config SCBB_CH224A_I2C_HEADER
        string "CH224A - I2C BSP header"
        default "axk_bsp_i2c.h" if SCBB_BSP_PLATFORM = "axk"
        default "stm32f10x_bsp_i2c.h"

    config SCBB_CH224A_I2C_PREFIX
        string "CH224A - I2C BSP function prefix"
        default "axk_bsp_i2c_soft" if SCBB_BSP_PLATFORM = "axk"
        default "bsp_i2c"

    config SCBB_CH224A_DELAY_HEADER
        string "CH224A - Delay BSP header"
        default "axk_bsp_delay.h" if SCBB_BSP_PLATFORM = "axk"
        default "stm32f10x_delay.h"

    config SCBB_CH224A_DELAY_PREFIX
        string "CH224A - Delay BSP function prefix"
        default "axk_bsp_delay" if SCBB_BSP_PLATFORM = "axk"
        default "delay"
endif

