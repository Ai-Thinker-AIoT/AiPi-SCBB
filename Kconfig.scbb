# --------------------------------------------------------------------------
# Pin assignment
#
# No board presets here. In the open SDK the board is the application:
# its app_config/.config carries these values as CONFIG_AXK_*, exactly
# like CONFIG_AT_UART_PIN_TX does. A manual scbb_board_config.h still
# overrides everything (the generated defines are #ifndef-guarded).
# --------------------------------------------------------------------------
menu "Pin assignment"

menu "SPI bus pins"
    config AXK_BSP_SPI0_SCLK_PIN
        int "SPI0 SCLK pin"
        default 13
    config AXK_BSP_SPI0_MOSI_PIN
        int "SPI0 MOSI pin"
        default 11
    config AXK_BSP_SPI0_MISO_PIN
        int "SPI0 MISO pin"
        default 11
    config AXK_BSP_SPI1_SCLK_PIN
        int "SPI1 SCLK pin"
        default 5
    config AXK_BSP_SPI1_MOSI_PIN
        int "SPI1 MOSI pin"
        default 19
    config AXK_BSP_SPI1_MISO_PIN
        int "SPI1 MISO pin"
        default 19
endmenu

menu "I2C bus pins"
    config AXK_BSP_I2C_SOFT_SCL_PIN
        int "Soft I2C SCL pin"
        default 8
    config AXK_BSP_I2C_SOFT_SDA_PIN
        int "Soft I2C SDA pin"
        default 18
    config AXK_BSP_I2C_SOFT_DELAY_US
        int "Soft I2C half-period delay (us)"
        default 5
    config AXK_BSP_I2C_SCL_PIN
        int "Hardware I2C SCL pin"
        default 4
    config AXK_BSP_I2C_SDA_PIN
        int "Hardware I2C SDA pin"
        default 5
endmenu

menu "UART bus pins"
    config SCBB_CUSTOM_UART_PINS
        bool "Override chip default UART pins"
        default n
        help
            By default the BSP uses the chip spec's UART pins. Enable
            this only when the board routes UART elsewhere. The numbers
            below are logical GPIO numbers (BL602 example: UART0
            TX=16/RX=7, UART1 TX=4/RX=5).
    if SCBB_CUSTOM_UART_PINS
        config AXK_BSP_UART0_TX_PIN
            int "UART0 TX pin"
            default 16
        config AXK_BSP_UART0_RX_PIN
            int "UART0 RX pin"
            default 7
        config AXK_BSP_UART1_TX_PIN
            int "UART1 TX pin"
            default 4
        config AXK_BSP_UART1_RX_PIN
            int "UART1 RX pin"
            default 5
    endif
endmenu

menu "Module pins"
    if SCBB_ST7789V_LCD_ENABLED
        config AXK_ST7789V_LCD_PIN_CS
            int "ST7789V CS pin"
            default 10
        config AXK_ST7789V_LCD_PIN_DC
            int "ST7789V DC pin"
            default 1
        config AXK_ST7789V_LCD_PIN_RST
            int "ST7789V RST pin"
            default 18
        config AXK_ST7789V_LCD_PIN_BLK
            int "ST7789V BLK pin (65535 = no backlight pin)"
            default 20
    endif
    if SCBB_DHT11_ENABLED
        config AXK_DHT11_PIN
            int "DHT11 data pin"
            default 0
    endif
    if SCBB_RELAY_ENABLED
        config AXK_RELAY_PIN
            int "Relay control pin"
            default 0
    endif
    if SCBB_DS1302_ENABLED
        config AXK_DS1302_PIN_CE
            int "DS1302 CE pin"
            default 16
        config AXK_DS1302_PIN_SCLK
            int "DS1302 SCLK pin"
            default 15
        config AXK_DS1302_PIN_IO
            int "DS1302 IO pin"
            default 14
    endif
    if SCBB_OLED_096_SPI_ENABLED
        config AXK_OLED_096_SPI_PIN_CS
            int "OLED CS pin"
            default 10
        config AXK_OLED_096_SPI_PIN_DC
            int "OLED DC pin"
            default 1
        config AXK_OLED_096_SPI_PIN_RST
            int "OLED RST pin"
            default 18
    endif
    if SCBB_HXD039B2_ENABLED
        config AXK_HXD039B2_BUSY_PIN
            int "HXD039B2 BUSY pin"
            default 1
    endif
    if SCBB_LLCC68_ENABLED
        config AXK_LLCC68_NSS_PIN
            hex "LLCC68 NSS pin (axk encoding)"
            default 0x4
        config AXK_LLCC68_NRESET_PIN
            hex "LLCC68 RESET pin (axk encoding)"
            default 0x10E
        config AXK_LLCC68_BUSY_PIN
            hex "LLCC68 BUSY pin (axk encoding)"
            default 0x0
        config AXK_LLCC68_DIO1_PIN
            hex "LLCC68 DIO1 pin (axk encoding)"
            default 0x101
    endif
endmenu

endmenu # Pin assignment

endmenu # AiPi-SCBB
