# AiPi-SCBB + open SDK（axk）构建配置
#
# 适用：aithinker_dev_open_sdk（中间件 aiio_*），bl602 / bl616 / bl616cl /
#       bl616_iot / bl618 / bs21 / ln882h / rtl8711dx / rtl8711fx / rtl8720dx。
#
# 用法（在 SCBB 仓库根目录）：
#   python scripts/gen_config_header.py scripts/axk.config scbb_config.h
# 或在 open SDK 组件里把本文件内容并入 .config 后跑 menuconfig/olddefconfig。
#
# 说明：
#   · WS2812 需要 PWM+DMA 亚微秒时序，ST7789V_LCD 的 .c 直接包含 bflb 头，
#     这两个模块 axk 不支持，故不在此配置中。
#   · 模块引脚宏（AXK_<MOD>_PIN 等）在各自模块头里，按实际接线修改。
#   · BSP 总线引脚在 BSP/axk/axk_bsp_config.h 里统一修改。

CONFIG_SCBB_USE_BSP=y
CONFIG_SCBB_BSP_PLATFORM="axk"

# ── CH224A（软件 I2C + 延时）────────────────────────────────────────
CONFIG_SCBB_CH224A_ENABLED=y
CONFIG_SCBB_CH224A_I2C_HEADER="axk_bsp_i2c.h"
CONFIG_SCBB_CH224A_I2C_PREFIX="axk_bsp_i2c_soft"
CONFIG_SCBB_CH224A_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_CH224A_DELAY_PREFIX="axk_bsp_delay"

# ── SHT3x（软件 I2C + 延时）────────────────────────────────────────
CONFIG_SCBB_SHT3X_ENABLED=y
CONFIG_SCBB_SHT3X_I2C_HEADER="axk_bsp_i2c.h"
CONFIG_SCBB_SHT3X_I2C_PREFIX="axk_bsp_i2c_soft"
CONFIG_SCBB_SHT3X_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_SHT3X_DELAY_PREFIX="axk_bsp_delay"

# ── HXD039B2（固定口 UART + GPIO + 延时）───────────────────────────
CONFIG_SCBB_HXD039B2_ENABLED=y
CONFIG_SCBB_HXD039B2_UART_HEADER="axk_bsp_uart.h"
CONFIG_SCBB_HXD039B2_UART_PREFIX="axk_bsp_uart_legacy"
CONFIG_SCBB_HXD039B2_GPIO_HEADER="axk_bsp_gpio.h"
CONFIG_SCBB_HXD039B2_GPIO_PREFIX="axk_bsp_gpio"
CONFIG_SCBB_HXD039B2_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_HXD039B2_DELAY_PREFIX="axk_bsp_delay"

# ── RELAY（GPIO + 延时）────────────────────────────────────────────
CONFIG_SCBB_RELAY_ENABLED=y
CONFIG_SCBB_RELAY_GPIO_HEADER="axk_bsp_gpio.h"
CONFIG_SCBB_RELAY_GPIO_PREFIX="axk_bsp_gpio"
CONFIG_SCBB_RELAY_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_RELAY_DELAY_PREFIX="axk_bsp_delay"

# ── DHT11（GPIO + 延时）────────────────────────────────────────────
CONFIG_SCBB_DHT11_ENABLED=y
CONFIG_SCBB_DHT11_GPIO_HEADER="axk_bsp_gpio.h"
CONFIG_SCBB_DHT11_GPIO_PREFIX="axk_bsp_gpio"
CONFIG_SCBB_DHT11_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_DHT11_DELAY_PREFIX="axk_bsp_delay"

# ── RD03_V2（带名 UART + 延时）─────────────────────────────────────
CONFIG_SCBB_RD03_V2_ENABLED=y
CONFIG_SCBB_RD03_V2_UART_HEADER="axk_bsp_uart.h"
CONFIG_SCBB_RD03_V2_UART_PREFIX="axk_bsp_uart"
CONFIG_SCBB_RD03_V2_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_RD03_V2_DELAY_PREFIX="axk_bsp_delay"

# ── INA226（事务式 I2C + 延时）─────────────────────────────────────
CONFIG_SCBB_INA226_ENABLED=y
CONFIG_SCBB_INA226_I2C_HEADER="axk_bsp_i2c.h"
CONFIG_SCBB_INA226_I2C_PREFIX="axk_bsp_i2c"
CONFIG_SCBB_INA226_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_INA226_DELAY_PREFIX="axk_bsp_delay"

# ── DS1302（GPIO + 延时）───────────────────────────────────────────
CONFIG_SCBB_DS1302_ENABLED=y
CONFIG_SCBB_DS1302_GPIO_HEADER="axk_bsp_gpio.h"
CONFIG_SCBB_DS1302_GPIO_PREFIX="axk_bsp_gpio"
CONFIG_SCBB_DS1302_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_DS1302_DELAY_PREFIX="axk_bsp_delay"

# ── OLED_096_SPI（软件 SPI + GPIO + 延时）──────────────────────────
CONFIG_SCBB_OLED_096_SPI_ENABLED=y
CONFIG_SCBB_OLED_096_SPI_SPI_HEADER="axk_bsp_spi.h"
CONFIG_SCBB_OLED_096_SPI_SPI_PREFIX="axk_bsp_spi"
CONFIG_SCBB_OLED_096_SPI_GPIO_HEADER="axk_bsp_gpio.h"
CONFIG_SCBB_OLED_096_SPI_GPIO_PREFIX="axk_bsp_gpio"
CONFIG_SCBB_OLED_096_SPI_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_OLED_096_SPI_DELAY_PREFIX="axk_bsp_delay"

# ── LLCC68（软件 SPI + GPIO + 延时）────────────────────────────────
CONFIG_SCBB_LLCC68_ENABLED=y
CONFIG_SCBB_LLCC68_SPI_HEADER="axk_bsp_spi.h"
CONFIG_SCBB_LLCC68_SPI_PREFIX="axk_bsp_spi"
CONFIG_SCBB_LLCC68_GPIO_HEADER="axk_bsp_gpio.h"
CONFIG_SCBB_LLCC68_GPIO_PREFIX="axk_bsp_gpio"
CONFIG_SCBB_LLCC68_DELAY_HEADER="axk_bsp_delay.h"
CONFIG_SCBB_LLCC68_DELAY_PREFIX="axk_bsp_delay"

CONFIG_SCBB_CONFIG_HEADER_PATH="scbb_config.h"
